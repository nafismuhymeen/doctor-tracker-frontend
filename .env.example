# NOTE: All variables below are read at BUILD time by Next.js and inlined into client bundles or rewrites.
# NEXT_PUBLIC_* variables are embedded directly into client JavaScript bundles and are PUBLIC.
# Never configure privileged or administrative credentials; only a read-only viewer account may be used.

# Base API URL used by browser client (use /api/v1 for same-origin rewrite proxy)
NEXT_PUBLIC_API_URL=/api/v1

# Internal backend URL used by Next.js rewrites proxy at build time
BACKEND_INTERNAL_URL=http://localhost:5000

# Optional Demo Credentials for quick sign-in (local development seed values only).
# Public in client bundles: only a read-only viewer account may be used!
NEXT_PUBLIC_DEMO_EMAIL=viewer@clinic.com
NEXT_PUBLIC_DEMO_PASSWORD=Password123!
