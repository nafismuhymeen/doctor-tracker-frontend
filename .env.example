# Base URL of Doctor Tracker Backend API
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Optional Demo Credentials for quick sign-in in demo/review environments.
# NOTE: All NEXT_PUBLIC_* variables are embedded into client JavaScript bundles and are PUBLIC.
# Never use admin or privileged credentials here; only configure read-only viewer accounts!
NEXT_PUBLIC_DEMO_EMAIL=viewer@example.com
NEXT_PUBLIC_DEMO_PASSWORD=Viewer12345!
